#!/usr/bin/env bash
# Run aider against the VM's Ollama API. Arguments are passed through to aider.
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "${ROOT}/config.sh"

AIDER="${AIDER_BIN:-${HOME:-$(getent passwd "$(id -u)" | cut -d: -f6)}/.local/bin/aider}"
[[ -x "$AIDER" ]] || {
  printf 'aider missing: run "sudo ./bootstrap.sh up".\n' >&2
  exit 1
}

export OLLAMA_API_BASE="http://${VM_IP[ollama]}:${OLLAMA_PORT}"
export AIDER_ANALYTICS=false

for arg in "$@"; do
  case "$arg" in
    --model|--model=*) exec "$AIDER" "$@" ;;
  esac
done
exec "$AIDER" --model "ollama_chat/${MODEL}" "$@"
