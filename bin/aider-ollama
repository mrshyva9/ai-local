#!/usr/bin/env bash
# Lance aider contre l'API Ollama de la VM. Arguments transmis à aider.
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "${ROOT}/config.sh"

AIDER="${ROOT}/data/client/bin/aider"
[[ -x "$AIDER" ]] || {
  printf 'aider absent : lancer « sudo ./bootstrap.sh up ».\n' >&2
  exit 1
}

export OLLAMA_API_BASE="http://${VM_IP[ollama]}:${OLLAMA_PORT}"
export AIDER_ANALYTICS=false

for arg in "$@"; do
  case "$arg" in
    --model|--model=*) exec "$AIDER" "$@" ;;
  esac
done
exec "$AIDER" --model "ollama_chat/${MODEL}" "$@"
